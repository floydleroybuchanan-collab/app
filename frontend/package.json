{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "preinstall": "node ./scripts/cmd-guard.js --preinstall",
    "postinstall": "node ./scripts/apply-media3-live-tv-patch.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "web": "expo start --web",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./tests/run-tests.mjs",
    "benchmark:phase1": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/phase1-benchmark.mjs",
    "torture:guide": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/phase2-guide-torture.mjs",
    "verify:native-config": "node ./scripts/verify-native-config.mjs",
    "verify:native-guide": "node ./scripts/verify-native-guide-architecture.mjs",
    "doctor": "expo-doctor",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@expo/vector-icons": "15.1.1",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-tvos/config-tv": "0.1.6",
    "@react-navigation/native": "^7.1.8",
    "date-fns": "4.1.0",
    "dayjs": "1.11.13",
    "expo": "54.0.37",
    "expo-blur": "15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "18.0.14",
    "expo-file-system": "19.0.24",
    "expo-font": "14.0.12",
    "expo-haptics": "15.0.8",
    "expo-image": "3.0.11",
    "expo-linear-gradient": "15.0.8",
    "expo-linking": "8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "15.0.8",
    "expo-splash-screen": "31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "3.0.9",
    "expo-symbols": "1.0.8",
    "expo-system-ui": "6.0.9",
    "expo-web-browser": "15.0.11",
    "fast-xml-parser": "5.10.1",
    "fflate": "0.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81.5-1",
    "react-native-dotenv": "3.4.11",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-web": "0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "eslint": "9.25.0",
    "eslint-config-expo": "10.0.0",
    "expo-doctor": "1.19.8",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@eslint/plugin-kit": "0.3.4",
    "postcss": "8.5.23",
    "uuid": "11.1.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": ["react-native-vector-icons"],
        "listUnknownPackages": true
      }
    }
  },
  "private": true
}
