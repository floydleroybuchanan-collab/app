<?xml version="1.0" encoding="utf-8"?>
<!--
  Fullscreen Media3 output. PR #23 / expo-video used SurfaceView for fullscreen
  (hardware overlay) and TextureView only for Guide preview. SurfaceView is
  construction-only on PlayerView, so this layout is separate from the preview
  TextureView layout.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/charm_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view" />
