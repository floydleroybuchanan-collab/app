<?xml version="1.0" encoding="utf-8"?>
<!--
  The one shared Media3 PlayerView is moved between the small Guide preview
  surface and the fullscreen player surface at runtime (see
  NativePlaybackManager.attachPlayerView). PlayerView's default surface_type
  is SurfaceView, which owns a separate compositor window outside the normal
  view hierarchy — removing/re-adding it across parents forces Android to
  destroy and recreate its underlying Surface, which is a documented source
  of "video renders at the wrong/old size" and "video never comes back,
  audio keeps playing" bugs (MediaCodec requires a live Surface at all
  times; see https://github.com/google/ExoPlayer/issues/5825 and
  https://github.com/google/ExoPlayer/issues/1084). TextureView is a normal
  view-hierarchy-rendered surface with no such lifecycle, so it resizes and
  reparents safely — the standard fix for this exact reparenting pattern.
  app:surface_type can only be set via XML at inflate time (PlayerView has
  no runtime setter for it), so this view must be inflated, not built with
  `PlayerView(context)`.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/charm_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
