<?xml version="1.0" encoding="utf-8"?>
<!--
  Each of the preview and fullscreen surfaces gets its own instance of this
  PlayerView, permanently parented into that exact surface and never moved to
  the other one (see NativePlaybackManager.attachSurface/ensurePlayerViewIn).
  Only the ExoPlayer bound to it changes.

  RC.1 rendered both Guide preview and fullscreen through TextureView. Keep
  that known-good rendering contract: unlike SurfaceView, TextureView is
  composited inside the normal React/Fabric view hierarchy, so clipping,
  stacking, opacity and navigation overlays cannot leave decoded video in a
  separate layer behind the app. The permanent per-owner PlayerViews still
  preserve the newer handoff/lifecycle improvement; only the render primitive
  is restored. PlayerView surface_type is construction-only and must be set in
  XML.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/charm_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view" />
