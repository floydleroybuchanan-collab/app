<?xml version="1.0" encoding="utf-8"?>
<!--
  Media3 output for Guide preview and fullscreen. TextureView composites in the
  same hardware layer as React Native / Fabric. SurfaceView paints in a separate
  overlay that Onn Google TV draws behind the opaque stack (#070711 / fade cards),
  which is the audio-with-black-picture failure.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/charm_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_artwork="false"
    app:shutter_background_color="@android:color/transparent" />
