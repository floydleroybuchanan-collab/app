<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:minHeight="112dp" android:background="@drawable/charm_vod_settings_card" android:focusable="true">
<TextView android:id="@android:id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#ECEBF2" android:textSize="15sp" android:fontFamily="@font/charm_geist_semibold" />
<TextView android:id="@android:id/summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BAB3CB" android:textSize="12sp" android:layout_marginTop="6dp" />
<SeekBar android:id="@+id/seekbar" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="10dp" android:progressTint="#A349F0" android:thumbTint="#CE95FF" />
<TextView android:id="@+id/seekbar_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#D9C9EB" />
</LinearLayout>