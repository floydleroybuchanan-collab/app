<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/charm_vod_panel_raised" />
            <stroke
                android:width="2dp"
                android:color="@color/charm_vod_focus" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/charm_vod_panel_raised" />
            <stroke
                android:width="2dp"
                android:color="@color/charm_vod_focus" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/charm_vod_panel" />
            <stroke
                android:width="1dp"
                android:color="#3B3560" />
        </shape>
    </item>
</selector>
