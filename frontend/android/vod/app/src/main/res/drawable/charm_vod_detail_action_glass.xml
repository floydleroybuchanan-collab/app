<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:startColor="#D45B20B1" android:centerColor="#B62D3D96" android:endColor="#B3168DD5" android:angle="0" />
            <stroke android:width="2dp" android:color="#FFFF79F7" />
            <padding android:left="12dp" android:right="12dp" android:top="9dp" android:bottom="9dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#BF6D2CD5" />
            <stroke android:width="2dp" android:color="#FFD5F7FF" />
            <padding android:left="12dp" android:right="12dp" android:top="9dp" android:bottom="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:startColor="#80452A78" android:endColor="#6610244F" android:angle="0" />
            <stroke android:width="1dp" android:color="#AA985BD8" />
            <padding android:left="12dp" android:right="12dp" android:top="9dp" android:bottom="9dp" />
        </shape>
    </item>
</selector>
