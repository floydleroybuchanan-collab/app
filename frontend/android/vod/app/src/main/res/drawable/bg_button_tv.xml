<selector xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:state_enabled="false"><shape><corners android:radius="12dp"/><solid android:color="#242531"/><stroke android:width="1dp" android:color="#34323F"/></shape></item>
 <item android:state_focused="true"><shape><corners android:radius="12dp"/><solid android:color="#7541D4"/><stroke android:width="2dp" android:color="#FFFFFF"/></shape></item>
 <item android:state_pressed="true"><shape><corners android:radius="12dp"/><solid android:color="#7541D4"/><stroke android:width="2dp" android:color="#D5C3FF"/></shape></item>
 <item android:state_selected="true"><shape><corners android:radius="12dp"/><solid android:color="#36254E"/><stroke android:width="1dp" android:color="#BA9BFF"/></shape></item>
 <item><shape><corners android:radius="12dp"/><solid android:color="#20222E"/><stroke android:width="1dp" android:color="#393747"/></shape></item>
