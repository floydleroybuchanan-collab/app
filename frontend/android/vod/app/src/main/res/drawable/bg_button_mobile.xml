 <item android:state_enabled="false"><shape><corners android:radius="12dp"/><solid android:color="#242531"/><stroke android:width="1dp" android:color="#34323F"/></shape></item>
 <item android:state_focused="true"><shape><corners android:radius="12dp"/><solid android:color="#7C3AED"/><stroke android:width="2dp" android:color="#FFFFFF"/></shape></item>
 <item android:state_pressed="true"><shape><corners android:radius="12dp"/><solid android:color="#7C3AED"/><stroke android:width="2dp" android:color="#D5C3FF"/></shape></item>
 <item android:state_selected="true"><shape><corners android:radius="12dp"/><solid android:color="#25143F"/><stroke android:width="1dp" android:color="#B76CFF"/></shape></item>
