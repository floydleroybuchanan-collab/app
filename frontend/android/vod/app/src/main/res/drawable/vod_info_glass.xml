<?xml version="1.0" encoding="utf-8"?>
<!-- Readability glass behind a title's name, rating, genres and description.
     Deep purple at ~62% so text reads clearly while the title's background
     art still shows through; a soft light edge matches the neon-glass theme.
     A plain shape drawable: no blur, no bitmap, nothing extra in memory. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#A61A0B33"
        android:centerColor="#9E1E0C3C"
        android:endColor="#8C1A0B33" />
    <stroke
        android:width="1dp"
        android:color="#47E2BEFF" />
    <corners android:radius="18dp" />
</shape>
